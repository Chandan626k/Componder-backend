# ─────────────────────────────────────────────────────────
# Compounder DNA Engine — Backend Environment Variables
# ─────────────────────────────────────────────────────────
# Copy this file to .env.local for local dev
# In production: set these in Vercel Dashboard → Settings → Environment Variables
# NEVER commit .env.local to git
# ─────────────────────────────────────────────────────────

# REQUIRED: Your OpenAI API key
# Get it from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-key-here

# OPTIONAL: Override model (default: gpt-4o-mini)
# Options: gpt-4o-mini (cheap) | gpt-4o (better) | gpt-3.5-turbo (cheapest)
OPENAI_MODEL=gpt-4o-mini

# OPTIONAL: Restrict CORS to your frontend domain
# Example: https://your-app.vercel.app
# Leave as * for development
ALLOWED_ORIGIN=*
